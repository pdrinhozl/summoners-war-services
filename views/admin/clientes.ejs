<%- include('../partials/header') %>

<div class="container dash-header">
  <div>
    <span class="eyebrow">Administração</span>
    <h1>Clientes</h1>
    <p class="muted">Gerencie as contas de clientes cadastrados.</p>
  </div>
</div>

<div class="container admin-layout">
  <%- include('_nav') %>
  <div class="admin-main">

<div class="container section">
  <form method="GET" action="/admin/clientes" class="filter-inline">
    <input type="text" name="q" value="<%= q %>" placeholder="Buscar por nome ou e-mail..." />
    <button class="btn btn-gold btn-sm" type="submit">Buscar</button>
  </form>

  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Nome</th><th>E-mail</th><th>Status</th><th>Cadastro</th><th></th></tr></thead>
      <tbody>
        <% clients.forEach(function(c){ %>
          <tr>
            <td><strong><%= c.name %></strong></td>
            <td class="muted small"><%= c.email %></td>
            <td><span class="status-pill <%= c.active ? 'status-approved' : 'status-rejected' %>"><%= c.active ? 'Ativo' : 'Desativado' %></span></td>
            <td class="muted small"><%= c.created_at %></td>
            <td class="cell-actions">
              <form method="POST" action="/admin/usuarios/<%= c.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-ghost btn-xs"><%= c.active ? 'Desativar' : 'Reativar' %></button></form>
              <form method="POST" action="/admin/usuarios/<%= c.id %>/excluir" onsubmit="return confirm('Excluir usuário?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-danger btn-xs">Excluir</button></form>
            </td>
          </tr>
        <% }); %>
        <% if (!clients.length) { %><tr><td colspan="5" class="muted center">Nenhum cliente encontrado.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

</div>
</div>

<%- include('../partials/footer') %>