<%- include('../partials/header') %>

<div class="container dash-header">
  <div>
    <span class="eyebrow">Painel do vendedor</span>
    <h1>Pedido <span class="quote-id"><%= order.id %></span></h1>
    <p class="muted"><%= order.title || 'Service personalizado' %></p>
  </div>
  <a href="/vendedor/pedidos" class="btn btn-ghost">Voltar</a>
</div>

<% var st = orderStatus[order.status] || orderStatus.pending_payment; %>
<div class="container order-hero">
  <div>
    <div class="order-id">#<%= order.id %></div>
    <div class="order-status-line">
      <span class="status-pill" style="--pill:<%= st.color %>"><%= st.label %></span>
      <% if (order.started_at) { %><span class="muted small">Iniciado em <%= order.started_at %></span><% } %>
      <% if (order.delivered_at) { %><span class="muted small">Entregue em <%= order.delivered_at %></span><% } %>
    </div>
  </div>
  <div class="total-price"><%= money(order.price) %> <span class="muted small" style="font-family:var(--font); font-size:0.78rem;">renda <%= money(order.price - order.seller_amount) %> → <%= money(order.seller_amount) %></span></div>
</div>

<div class="container split">
  <div class="left">
    <div class="panel">
      <div class="panel-head"><h2>Dados do cliente e do pedido</h2></div>
      <ul class="detail-list">
        <li><span>Nome do contato</span><%= order.client_name || '—' %></li>
        <li><span>WhatsApp</span><%= order.client_whatsapp || '—' %></li>
        <li><span>Jogo</span><%= order.game_name || '—' %></li>
        <li><span>Rank atual</span><%= order.game_rank || '—' %></li>
        <li><span>Caixas / material</span><%= order.game_boxes || '—' %></li>
        <li><span>Comissão da plataforma</span><%= money(order.price - order.seller_amount) %></li>
        <li><span>Seu saldo ao concluir</span><strong style="color:var(--gold)"><%= money(order.seller_amount) %></strong></li>
      </ul>
      <% if (order.message) { %>
        <p class="form-note" style="margin-top:1rem">DETALHE DO PEDIDO</p>
        <div class="quote-message"><%= order.message %></div>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-head" id="chat"><h2>Conversa</h2></div>
      <div class="chat-box">
        <div class="chat-thread">
          <% if (!messages.length) { %>
            <p class="muted small center">Nenhuma mensagem ainda.</p>
          <% } %>
          <% messages.forEach(function(m){ var me = m.sender_id === user.id; %>
            <div class="msg <%= me ? 'me' : '' %>">
              <div class="msg-head"><strong><%= m.sender_role === 'admin' ? 'Equipe' : m.sender_role === 'seller' ? 'Você' : 'Cliente' %></strong><span><%= m.created_at %></span></div>
              <div class="msg-body"><%= m.body %></div>
            </div>
          <% }); %>
        </div>
        <form method="POST" action="/vendedor/pedidos/<%= order.id %>/mensagem" class="chat-input">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <textarea name="message" maxlength="2000" placeholder="Responda ao cliente..." required></textarea>
          <button class="btn btn-gold" type="submit">Enviar</button>
        </form>
      </div>
    </div>
  </div>

  <div class="right">
    <div class="panel">
      <div class="panel-head"><h2>Ações</h2></div>
      <% if (order.status === 'paid') { %>
        <form method="POST" action="/vendedor/pedidos/<%= order.id %>/iniciar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-gold btn-block" type="submit">Iniciar execução</button>
        </form>
        <p class="side-note">O pagamento já foi confirmado. Comece assim que puder.</p>
      <% } else if (order.status === 'in_progress') { %>
        <form method="POST" action="/vendedor/pedidos/<%= order.id %>/entregar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-green btn-block btn-lg" type="submit">Marcar como entregue</button>
        </form>
        <p class="side-note">Após entregar, o cliente confirma o recebimento para liberar seu saldo.</p>
      <% } else if (order.status === 'delivered') { %>
        <div class="banner banner-warn">Pedido entregue. Aguardando o cliente confirmar o recebimento.</div>
      <% } else if (order.status === 'completed') { %>
        <div class="banner banner-green">Pedido concluído. <%= money(order.seller_amount) %> creditados no seu saldo.</div>
      <% } else if (order.status === 'pending_payment' || order.status === 'awaiting_confirm') { %>
        <p class="muted small">Aguardando o pagamento do cliente. Você será avisado quando ele for confirmado.</p>
      <% } else { %>
        <div class="banner banner-red"><%= order.status === 'refunded' ? 'Pedido reembolsado' : 'Pedido cancelado' %></div>
      <% } %>
    </div>

    <% if (review) { %>
      <div class="panel">
        <div class="panel-head"><h2>Avaliação do cliente</h2></div>
        <div class="review">
          <div class="review-top">
            <span class="review-stars"><%= stars(review.rating) %></span>
            <span class="review-time"><%= review.created_at %></span>
          </div>
          <% if (review.comment) { %><p class="review-body"><%= review.comment %></p><% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>