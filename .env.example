# Copie para .env e ajuste os valores.

# Porta do servidor
PORT=3050

# URL pública usada nos e-mails (links de redefinição) e SEO
SITE_URL=http://localhost:3050

# Segredo da sessão (obrigatório em produção, troque por um valor longo e aleatório)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# NODE_ENV=production ativa cookies seguros (HTTPS) e cache de assets
# NODE_ENV=production

# E-mail SMTP (opcional). Sem SMTP, o sistema não envia e-mails reais:
# fica registrado no console e o e-mail é marcado como verificado automaticamente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Banco de dados. Por padrão usa ./data/app.db. Use outro caminho para testes.
# DB_PATH=./data/test.db
# Imagens privadas das solicitações (padrão: data/attachments).
# ATTACHMENT_DIR=/caminho/persistente/attachments

# Railway: monte um volume em /data para guardar banco, anexos e imagens.
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads
# INITIAL_ADMIN_EMAIL=admin@swservice.com
# INITIAL_ADMIN_PASSWORD=defina-uma-senha-aleatoria-com-16-ou-mais-caracteres
