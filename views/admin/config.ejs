<%- include('../partials/header') %>

<div class="container dash-header">
  <div>
    <span class="eyebrow">Administração</span>
    <h1>Configurações do site</h1>
    <p class="muted">Edite as informações exibidas para os clientes.</p>
  </div>
</div>

<div class="container admin-layout">
  <%- include('_nav') %>
  <div class="admin-main">

<div class="container section">
  <form method="POST" action="/admin/config" class="card-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h2 class="form-section">Identidade</h2>
    <div class="grid-2">
      <div class="field"><label>Nome do site</label><input type="text" name="site_name" value="<%= s.site_name || '' %>" /></div>
      <div class="field"><label>Slogan</label><input type="text" name="tagline" value="<%= s.tagline || '' %>" /></div>
    </div>
    <div class="field"><label>Título do banner</label><input type="text" name="hero_title" value="<%= s.hero_title || '' %>" /></div>
    <div class="field"><label>Subtítulo do banner</label><textarea name="hero_subtitle" rows="2"><%= s.hero_subtitle || '' %></textarea></div>
    <div class="grid-2">
      <div class="field"><label>URL pública (SEO)</label><input type="text" name="site_url" placeholder="https://suaempresa.com" value="<%= s.site_url || '' %>" /></div>
      <div class="field"><label>Comissão da plataforma (%)</label><input type="number" name="commission_pct" min="0" max="100" step="0.1" value="<%= s.commission_pct || '15' %>" /><p class="form-note">Percentual retido de cada venda concluída.</p></div>
    </div>

    <h2 class="form-section">Pagamentos (Pix)</h2>
    <div class="grid-2">
      <div class="field"><label>Chave Pix (e-mail, CPF/CNPJ, telefone ou aleatória)</label><input type="text" name="pix_key" placeholder="contato@suaempresa.com" value="<%= s.pix_key || '' %>" /></div>
      <div class="field"><label>Nome do recebedor</label><input type="text" name="merchant_name" value="<%= s.merchant_name || '' %>" /></div>
    </div>
    <div class="field"><label>Cidade do recebedor</label><input type="text" name="merchant_city" value="<%= s.merchant_city || '' %>" /></div>
    <p class="form-note">Ao preencher a chave Pix, o sistema passa a exibir um Pix "copia e cola" (EMV) no pedido do cliente. A confirmação de pagamento é manual pela equipe.</p>

    <h2 class="form-section">Contato</h2>
    <div class="grid-3">
      <div class="field"><label>E-mail</label><input type="email" name="contact_email" value="<%= s.contact_email || '' %>" /></div>
      <div class="field"><label>WhatsApp (só números, com DDI)</label><input type="text" name="contact_whatsapp" value="<%= s.contact_whatsapp || '' %>" /></div>
      <div class="field"><label>Link do Discord</label><input type="text" name="contact_discord" value="<%= s.contact_discord || '' %>" /></div>
    </div>

    <button class="btn btn-gold btn-lg" type="submit">Salvar configurações</button>
  </form>
</div>

</div>
</div>

<%- include('../partials/footer') %>