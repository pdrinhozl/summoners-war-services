<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : settings.tagline %>" />
  <title><%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= settings.site_name %></title>
  <% var base = baseUrl; %>
  <link rel="canonical" href="<%= base %><%= path %>" />
  <meta property="og:site_name" content="<%= settings.site_name %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= settings.site_name %>" />
  <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : settings.tagline %>" />
  <meta property="og:url" content="<%= base %><%= path %>" />
  <link rel="icon" href="/img/favicon.svg" id="favicon" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= settings.site_name %>",
    "url": "<%= base %>/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= base %>/services?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <script>
  (function () {
    var t = 'dark';
    try { t = localStorage.getItem('theme'); } catch (e) { /* noop */ }
    if (t !== 'light' && t !== 'dark') {
      t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.dataset.theme = t;
    var fi = document.getElementById('favicon');
    if (fi) { fi.href = t === 'light' ? '/img/favicon-light.svg' : '/img/favicon.svg'; }
  })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/">
        <img src="/img/logo.svg" alt="" class="brand-logo" />
        <span class="brand-text"><%= settings.site_name %></span>
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" />
      <nav class="nav-links">
        <a href="/services" class="<%= path.startsWith('/services') ? 'active' : '' %>">Serviços</a>
        <a href="/como-funciona" class="<%= path === '/como-funciona' ? 'active' : '' %>">Como funciona</a>
        <a href="/seja-um-vendedor" class="<%= path === '/seja-um-vendedor' ? 'active' : '' %>">Seja vendedor</a>
        <% if (user) { %>
          <a href="/painel" class="<%= path.startsWith('/cliente') || path.startsWith('/vendedor') || path.startsWith('/admin') ? 'active' : '' %>">Meu painel<% if (unreadCount > 0) { %> <em class="nav-badge"><%= unreadCount %></em><% } %></a>
          <a href="/logout" class="btn btn-ghost btn-sm">Sair</a>
        <% } else { %>
          <a href="/login" class="<%= path === '/login' ? 'active' : '' %>">Entrar</a>
          <a href="/registro" class="btn btn-outline btn-sm">Criar conta</a>
        <% } %>
        <a href="/orcamento" class="btn btn-gold btn-sm">Orçamento grátis</a>
      </nav>
      <div class="nav-end">
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="Alternar tema claro/escuro" title="Alternar tema">
          <span class="sun-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
          <span class="moon-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></span>
        </button>
        <label for="nav-toggle" class="nav-burger" aria-label="Menu"><span></span><span></span><span></span></label>
      </div>
    </div>
  </header>

  <% if (flash && flash.length) { %>
    <div class="container flash-stack">
      <% flash.forEach(function(f){ %>
        <div class="flash flash-<%= f.type %>"><%= f.text %></div>
      <% }); %>
    </div>
  <% } %>

  <main>