<%- include('../partials/header') %>

<div class="container dash-header">
  <div>
    <span class="eyebrow">Painel do vendedor</span>
    <h1><%= formTitle %></h1>
    <p class="muted">Preencha as informações. Alterações em services publicados passam por nova aprovação.</p>
  </div>
</div>

<div class="container admin-layout">
  <%- include('_nav') %>
  <div class="admin-main">

<div class="container section">
  <form method="POST" action="<%= service ? '/vendedor/servicos/' + service.id : '/vendedor/servicos/novo' %>" enctype="multipart/form-data" class="card-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h2 class="form-section">Informações principais</h2>
    <div class="field">
      <label>Título do service *</label>
      <input type="text" name="title" value="<%= service ? service.title : '' %>" required placeholder="Ex: Boost de Arena até C1" />
    </div>
    <div class="grid-2">
      <div class="field">
        <label>Categoria *</label>
        <select name="category_id" required>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= service && service.category_id === c.id ? 'selected' : '' %>><%= iconLabel(c.icon) %> <%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field">
        <label>Imagem (arquivo)</label>
        <input type="file" name="image" accept="image/*" />
        <% if (service && service.image) { %><small class="muted">Atual: <img src="<%= service.image %>" class="thumb" alt="" loading="lazy" /></small><% } %>
      </div>
    </div>
    <div class="field">
      <label>Ou URL da imagem</label>
      <input type="text" name="image" value="<%= service ? service.image : '' %>" placeholder="/img/default-service.png" />
    </div>
    <div class="field">
      <label>Resumo curto</label>
      <input type="text" name="short" maxlength="160" value="<%= service ? service.short : '' %>" placeholder="Uma frase que resume o service" />
    </div>
    <div class="field">
      <label>Descrição completa</label>
      <textarea name="description" rows="7"><%= service ? service.description : '' %></textarea>
    </div>

    <h2 class="form-section">Preço e prazo</h2>
    <div class="grid-4">
      <div class="field"><label>Preço de *</label><input type="number" step="0.01" name="price_from" value="<%= service ? service.price_from : '' %>" /></div>
      <div class="field"><label>Preço até</label><input type="number" step="0.01" name="price_to" value="<%= service ? service.price_to : '' %>" /></div>
      <div class="field"><label>Entrega mín (dias)</label><input type="number" name="delivery_min" value="<%= service ? service.delivery_min : 1 %>" /></div>
      <div class="field"><label>Entrega máx (dias)</label><input type="number" name="delivery_max" value="<%= service ? service.delivery_max : 1 %>" /></div>
    </div>

    <h2 class="form-section">Detalhes</h2>
    <div class="field">
      <label>O que está incluso (um item por linha)</label>
      <textarea name="includes" rows="5" placeholder="Item 1&#10;Item 2&#10;Item 3"><%= service ? (editIncludes || '') : '' %></textarea>
    </div>
    <div class="field">
      <label>Requisitos</label>
      <textarea name="requirements" rows="4"><%= service ? service.requirements : '' %></textarea>
    </div>

    <button class="btn btn-gold btn-lg" type="submit"><%= service ? 'Salvar alterações' : 'Enviar para aprovação' %></button>
  </form>
</div>

</div>
</div>

<%- include('../partials/footer') %>